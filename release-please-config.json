{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "netz_noe_smartmeter",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/netz_noe_smartmeter/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name=='netz-noe-smartmeter')].version"
        }
      ]
    }
  }
}
