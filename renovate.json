{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Vienna",
  "ignorePaths": [
    "ha-dev-config/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Python version follows what Home Assistant supports, bump manually",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "groupName": "python packages"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit"
    },
    {
      "matchDepTypes": [
        "dev"
      ],
      "groupName": "python dev dependencies"
    },
    {
      "description": "Dev HA image and test harness pin the same Home Assistant version, update together",
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant",
        "pytest-homeassistant-custom-component"
      ],
      "groupName": "home assistant"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchManagers": [
        "pep621",
        "uv",
        "github-actions",
        "pre-commit"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    }
  ]
}
