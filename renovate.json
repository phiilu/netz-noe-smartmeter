{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Vienna",
  "ignorePaths": [
    "ha-dev-config/**"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Python version follows what Home Assistant supports, bump manually",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "groupName": "python packages"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit"
    },
    {
      "matchDepTypes": [
        "dev"
      ],
      "groupName": "python dev dependencies"
    },
    {
      "description": "Dev HA image and test package pin the same Home Assistant version, update together",
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant",
        "pytest-homeassistant"
      ],
      "groupName": "home assistant"
    },
    {
      "description": "ghcr.io gives Renovate no release dates, so minimumReleaseAge would hold the image back for good",
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "HACS test instance stays on 2026.10, HACS only runs before Home Assistant 2026.11",
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant"
      ],
      "matchCurrentValue": "/^2026\\.10\\./",
      "enabled": false
    }
  ]
}
